{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/(.*)", "destination": "/admin/index.html" },
    { "source": "/", "destination": "/index.html" }
  ],
  "functions": {
    "api/[...path].js": {
      "includeFiles": "backend/data/**"
    }
  }
}
