# Runtime
NODE_ENV=development
PORT=3000

# Required
# Use ONE of these database variables:
# 1) DATABASE_URL (preferred)
# 2) SUPABASE_DB_URL (alias)
# Tip: In Supabase, copy Connection string -> URI (transaction mode / pooler is recommended for serverless).
DATABASE_URL=postgresql://username:password@host:5432/database
# SUPABASE_DB_URL=postgresql://postgres:password@aws-0-region.pooler.supabase.com:6543/postgres
JWT_SECRET=replace-with-a-strong-random-string

# Optional (required only if using hero video upload)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token

# Optional Postgres pool tuning
PGPOOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=10000

# Optional bootstrap admin account.
# To auto-create an admin user during initial seed, set both ADMIN_CREDENTIAL and ADMIN_PASSWORD.
ADMIN_CREDENTIAL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=Moto Admin
