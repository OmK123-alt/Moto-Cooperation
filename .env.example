# Runtime
NODE_ENV=development
PORT=3000

# Required
# Use ONE of these database variables (Vercel import friendly):
# 1) `DATABASE_URL` (preferred)
# 2) `SUPABASE_DB_URL` or `SUPABASE_DATABASE_URL` (direct Supabase connection string)
# 3) Provide DB components (useful when importing envs that separate values):
#    `SUPABASE_DB_HOST`, `SUPABASE_DB_PORT`, `SUPABASE_DB_USER`, `SUPABASE_DB_PASSWORD`, `SUPABASE_DB_NAME`
#    or the equivalent `PGHOST`, `PGPORT`, `PGUSER`, `PGPASSWORD`, `PGDATABASE`.
# Tip: In Supabase, copy "Connection string -> URI" (transaction mode / pooler is recommended for serverless).
DATABASE_URL=postgresql://postgres.vraxparyiltzhbvnasir:Shakkya_@123@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# Example direct Supabase pooler URL (optional)
# SUPABASE_DB_URL=postgresql://postgres:password@aws-0-region.pooler.supabase.com:6543/postgres

# Component-style variables (optional)
# SUPABASE_DB_HOST=aws-0-region.pooler.supabase.com
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=replace-with-db-password
# SUPABASE_DB_NAME=postgres

